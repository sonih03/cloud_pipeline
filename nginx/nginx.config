events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout 65;

    # 클라이언트 이미지 업로드 용량 제한 해제 (기본 1MB -> 50MB)
    client_max_body_size 50M;

    upstream backend_upstream {
        server backend:8000;
    }

    server {
        listen 80;
        server_name localhost;

        # React 프론트엔드 정적 파일 서빙
        location / {
            root /usr/share/nginx/html;
            index index.html index.htm;
            try_files $uri $uri/ /index.html;
        }

        # FastAPI RAG API 라우팅
        location /rag/ {
            proxy_pass http://backend_upstream/rag/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }

        # FastAPI 정적 이미지 라우팅
        location /static/ {
            proxy_pass http://backend_upstream/static/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # FastAPI Swagger Docs 라우팅
        location /docs {
            proxy_pass http://backend_upstream/docs;
            proxy_set_header Host $host;
        }
        location /openapi.json {
            proxy_pass http://backend_upstream/openapi.json;
            proxy_set_header Host $host;
        }
    }
}